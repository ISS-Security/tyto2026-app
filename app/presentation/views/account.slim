- system_roles = account.system_roles.sort
- is_self = viewer && viewer.username == account.username
- viewer_is_admin = viewer&.admin?
- can_manage = viewer_is_admin && !is_self
- assignable = %w[admin creator member] - system_roles

h1 Account Details

div class="container"
  / Avatar shown only when present (SSO accounts); password accounts render
  / nothing here — no placeholder.
  - if account.avatar
    div class="row mb-3"
      div class="col-sm-3"
        strong Avatar:
      div class="col-sm-9"
        img src=account.avatar alt="Profile photo" class="rounded" width="72" height="72"
  div class="row mb-2"
    div class="col-sm-3"
      strong Username:
    div class="col-sm-9"
      = account.username
  div class="row mb-2"
    div class="col-sm-3"
      strong Email:
    div class="col-sm-9"
      = account.email

  div class="row mb-3 mt-4"
    div class="col-sm-3"
      strong System roles:
    div class="col-sm-9"
      - if system_roles.empty?
        span class="text-muted" No system roles
      - else
        - system_roles.each do |role|
          span class="badge bg-dark me-1"
            = role
          - if can_manage
            form method='post' action="/account/#{account.username}/system_roles/#{role}" class="d-inline me-2"
              input type='hidden' name='_method' value='delete'
              button type='submit' class="btn btn-sm btn-outline-danger py-0" Revoke

      - if can_manage && !assignable.empty?
        div class="mt-2 d-flex flex-wrap gap-2"
          - assignable.each do |role|
            form method='post' action="/account/#{account.username}/system_roles/#{role}" class="d-inline"
              input type='hidden' name='_method' value='put'
              button type='submit' class="btn btn-sm btn-outline-primary"
                | Grant&nbsp;
                = role

  div class="row mb-2"
    div class="col-sm-3"
      strong Course roles:
    div class="col-sm-9"
      - if account.enrollments.empty?
        span class="text-muted" Not enrolled in any courses
      - else
        ul class="list-unstyled mb-0"
          - account.enrollments.each do |e|
            li
              span class="me-2"
                = e['course_name']
              == render '_role_badge', locals: { role: e['role'] }

  - if is_self && api_key
    div class="row top-buffer mt-4"
      div class="col-sm-12"
        h3 API Access
        p class="text-muted mb-2"
          ' Read-only API key (valid for one month). Hand this to a tool or
          | deputy that should be able to read your data but never change it.
        a class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" href="#api_key" role="button" aria-expanded="false" aria-controls="api_key"
          | Show key
        div id="api_key" class="collapse mt-2"
          div class="card card-body"
            pre class="text-wrap mb-0"
              = api_key
