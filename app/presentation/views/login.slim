div class="row"
  div class="col-sm-3"
  div class="col-sm-6"
    h4 class="text-center" Login with credentials

    == render '_validation_errors'

    form method='post' action='/auth/login' id='form-login' accept-charset="UTF-8"
      div class="form-group mb-3"
        label for='input-username' Username
        input type='text' name='username' id='input-username' class="form-control" value=(params['username'] || '')
      div class="form-group mb-3"
        label for='input-password' Password
        input type='password' name='password' id='input-password' class="form-control"
      button type='submit' id='button-login' value='login' class="btn btn-primary w-100" Login

    div class="text-center text-muted my-3" — or —

    / Brand-correct Google "G" mark, inlined (no Font Awesome in this app).
    a class="btn btn-outline-dark w-100 d-flex align-items-center justify-content-center gap-2" id='button-google-login' href=google_oauth_url
