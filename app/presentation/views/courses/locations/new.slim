- @load_maps = true

h1 Add location

== render '_validation_errors'

p class="text-muted"
  | Click on the map to place a marker at the venue, or use "Get my current location" if you're standing there.

form method='post' action="/courses/#{course_id}/locations" id='form-location' accept-charset="UTF-8"
  div class="form-group mb-3"
    label for='input-location-name' Venue name
    input type='text' name='name' id='input-location-name' class="form-control" maxlength="200" value=(params['name'] || '')

  input type='hidden' name='latitude' id='input-latitude' value=(params['latitude'] || '')
  input type='hidden' name='longitude' id='input-longitude' value=(params['longitude'] || '')

  / Map init: assets/js/location_form.js (inline scripts/styles blocked by CSP)
  div id='location-map' class="map-canvas mb-3 rounded border"
  div id='map-fallback' class="mb-3 d-none"
    div class="alert alert-warning"
      | Map unavailable. Enter coordinates manually.
    div class="row g-2"
      div class="col-sm-6"
        label for='fallback-latitude' Latitude
        input type='number' step='any' id='fallback-latitude' class="form-control" min='-90' max='90'
      div class="col-sm-6"
        label for='fallback-longitude' Longitude
        input type='number' step='any' id='fallback-longitude' class="form-control" min='-180' max='180'

  div class="mb-3"
    button type='button' id='get-location-btn' class="btn btn-outline-secondary" Use my current location
    span id='coords-display' class="ms-2 text-muted"

  button type='submit' id='submit-location' class="btn btn-primary" Save location
  a class="btn btn-link" href="/courses/#{course_id}" Cancel

