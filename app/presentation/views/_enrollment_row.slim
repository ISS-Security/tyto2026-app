- first = enrollments.first
- username = first.username || "Account ##{first.account_id}"

li class="list-group-item"
  div class="d-flex flex-wrap align-items-center gap-2"
    span class="me-2"
      = username
    - enrollments.each do |e|
      span class="d-inline-flex align-items-center"
        == render '_role_badge', locals: { role: e.role }
        - if teaching
          form method='post' action="/courses/#{course_id}/enrollments/#{e.id}" class="d-inline ms-1"
            input type='hidden' name='_method' value='delete'
            button type='submit' class="btn btn-sm btn-link text-danger p-0 lh-1" aria-label="Remove #{e.role}" title="Remove #{e.role}" &times;
